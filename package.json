{
  "name": "hukdzen",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "analyze": "source-map-explorer 'build/assets/index-CPHA2LUs.js' 'build/assets/ItemPage-*.js' 'build/assets/vendor-mui-*.js' --html build/bundle-analysis.html",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:verbose": "npx vitest run --reporter verbose",
    "test:coverage": "CI=true npm test -- --env=jsdom --coverage",
    "test:winCoverage": "set CI=true&& npm test -- --env=jsdom --coverage",
    "test:ide": "jest --watchAll=false --reporters=default",
    "postInstall": "patch-package",
    "setup": "npm install && npx patch-package",
    "try-again": "npx patch-package @aws-amplify/storage && rm -rf node_modules/ && npm run setup",
    "build:cli": "cp src/utils/translator.js src/utils/translator.cjs && sed -i 's/export default Translator;/module.exports = Translator;/' src/utils/translator.cjs",
    "codegen": "mkdir -p src/graphql && npx ampx generate graphql-client-code --format graphql-codegen --statement-target typescript --type-target typescript --out src/graphql",
    "graphql:clean": "rm -rf src/graphql",
    "graphql:codegen": "mkdir -p src/graphql && npx ampx generate graphql-client-code --format graphql-codegen --statement-target typescript --type-target typescript --out src/graphql --profile dev",
    "graphql:move": "mkdir -p src/graphql && mv -f queries.ts mutations.ts subscriptions.ts schema.graphql graphql.ts graphql.d.ts operations.ts API.ts src/graphql 2>/dev/null || true",
    "graphql:sync": "[ -f src/graphql/API.ts ] && cp -f src/graphql/API.ts amplify/functions/shared/graphql/ && [ -f src/graphql/queries.ts ] && cp -f src/graphql/queries.ts amplify/functions/shared/graphql/ && [ -f src/graphql/mutations.ts ] && cp -f src/graphql/mutations.ts amplify/functions/shared/graphql/",
    "graphql:regen": "npm run graphql:clean && npm run graphql:codegen && npm run graphql:sync",
    "graphql:safeRegen": "npm run graphql:clean && npm run graphql:codegen && npm run graphql:move && npm run graphql:sync",
    "sbx:dev": "npx ampx sandbox --profile dev",
    "sbx:delete": "npx ampx sandbox delete --profile dev -y",
    "sbx:reset": "npm run sbx:delete && npm run sbx:dev",
    "sbx:seed": "./amplify/sandbox/seed-users.sh"
  },
  "dependencies": {
    "@aws-amplify/core": "^6.12.1",
    "@aws-amplify/storage": "^6.12.0",
    "@aws-amplify/ui": "6.10.3",
    "@aws-amplify/ui-react": "^6.11.2",
    "@aws-amplify/ui-react-core": "3.4.3",
    "@aws-appsync/utils": "^2.0.3",
    "@cyntler/react-doc-viewer": "^1.17.0",
    "@date-io/date-fns": "^2.16.0",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.10.6",
    "@mui/material": "^5.10.11",
    "@mui/x-data-grid": "^5.17.6",
    "@mui/x-date-pickers": "^5.0.4",
    "@react-router/node": "^7.8.2",
    "@reduxjs/toolkit": "^2.2.3",
    "@types/body-parser": "1.19.6",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "aws-amplify": "^6.16.0",
    "braces": "3.0.3",
    "cross-spawn": "7.0.5",
    "date-fns": "^2.29.3",
    "http-proxy-middleware": "2.0.7",
    "jose": "^6.1.3",
    "js-sha256": "^0.11.1",
    "notistack": "^3.0.1",
    "nth-check": "^2.1.1",
    "path-to-regexp": "0.1.10",
    "pdfjs-dist": "4.2.67",
    "react": "^18.2.0",
    "react-app-polyfill": "^3.0.0",
    "react-dom": "^18.2.0",
    "react-pdf": "7.7.3",
    "react-redux": "^9.1.0",
    "react-router": "^7.8.2",
    "redux-saga": "^1.2.1",
    "rollup": "2.79.2",
    "tss-react": "^4.3.2",
    "web-vitals": "^2.1.4",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.20.0",
    "@aws-amplify/backend-cli": "^1.8.2",
    "@babel/core": "^7.28.3",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@react-router/dev": "^7.8.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^27.5.2",
    "@types/jest-when": "^3.5.2",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^24.3.0",
    "@types/node-fetch": "^2.6.4",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "aws-cdk-lib": "^2.234.1",
    "babel-jest": "^30.0.5",
    "constructs": "^10.4.5",
    "css-mediaquery": "^0.1.2",
    "esbuild": "^0.27.2",
    "form-data": "^4.0.4",
    "jsdom": "^26.1.0",
    "jsdom-worker": "^0.3.0",
    "mime-types": "^2.1.35",
    "node-fetch": "^2.6.13",
    "patch-package": "^8.0.0",
    "redux-saga-test-plan": "^4.0.6",
    "source-map-explorer": "^2.5.3",
    "ts-jest": "^29.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^9.0.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vitest-when": "^0.7.0",
    "window-resizeto": "^0.0.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "max-len": [
        "warn",
        {
          "code": 120,
          "ignoreUrls": true
        }
      ],
      "@typescript-eslint/consistent-type-imports": [
        "error",
        {
          "prefer": "type-imports",
          "disallowTypeAnnotations": false
        }
      ]
    }
  },
  "browserslist": [
    "> 0.2%",
    "not dead",
    "last 2 chrome version",
    "last 2 firefox version",
    "last 2 safari version"
  ]
}
