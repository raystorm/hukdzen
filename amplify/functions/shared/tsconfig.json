{
   "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "esModuleInterop": true,
      "skipLibCheck": true,
      "strict": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "types": ["node", "jest"]
   },
   "include": ["**/*.ts"],
   "exclude": ["node_modules"]
}
