{
   "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["ES2020"],
      "esModuleInterop": true,
      "skipLibCheck": true,
      "strict": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "types": ["node", "jest"],
      "allowJs": true,
      "checkJs": false
   },
   "include": ["**/*.ts"],
   "exclude": ["node_modules", "cdk.out"]
}
